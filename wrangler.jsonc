{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gym-rat",
  "compatibility_date": "2026-09-26",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application"
  },
  // Serve the app on your own subdomain (Cloudflare creates the DNS record + certificate)
  "routes": [{ "pattern": "gymrat.joseph0x45.com", "custom_domain": true }]
}
